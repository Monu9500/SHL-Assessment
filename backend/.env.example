# Required: Groq API key from https://console.groq.com (never commit real keys)
GROQ_API_KEY=YOUR_GROQ_API_KEY

# Model (Groq-hosted)
GROQ_MODEL=llama-3.3-70b-versatile

# CORS origins (comma-separated). For local Vite: http://localhost:5173
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Optional overrides
LOG_LEVEL=INFO
CATALOG_URL=https://tcp-us-prod-rnd.shl.com/voiceRater/shl-ai-hiring/shl_product_catalog.json
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
TOP_K_RETRIEVAL=48
GROQ_TIMEOUT_SECONDS=28
